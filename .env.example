# Configuration du script de déploiement deploy.sh.
# Copier en .env (gitignoré) et compléter avant d'exécuter ./deploy.sh.

# --- Identité du projet GCP ---
PROJECT_ID=unlock-db
REGION=europe-west1

# --- Cloud Run ---
SERVICE_NAME=unlock-server
ARTIFACT_REPO=unlock
IMAGE_TAG=latest
MIN_INSTANCES=0
MAX_INSTANCES=3
CLOUD_RUN_CONCURRENCY=80
CLOUD_RUN_MEMORY=256Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=3600

# --- WebSocket / CORS ---
# Origines autorisées par le serveur (CSV, sans trailing slash).
# Doit inclure l'URL Firebase Hosting de prod.
ALLOWED_ORIGINS=https://unlock-db.web.app,https://unlock-db.firebaseapp.com

# --- Firebase Hosting / Firestore ---
FIREBASE_SITE=unlock-db

# --- Client (injecté dans client/.env.production au moment du build) ---
VUE_APP_FIREBASE_API_KEY=
VUE_APP_FIREBASE_AUTH_DOMAIN=unlock-db.firebaseapp.com
VUE_APP_FIREBASE_PROJECT_ID=unlock-db
VUE_APP_FIREBASE_STORAGE_BUCKET=unlock-db.appspot.com
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=
VUE_APP_FIREBASE_APP_ID=
# VUE_APP_WEBSOCKET_URL est calculée à partir de l'URL Cloud Run par le script.
