# Configuration de dev local avec émulateurs Firebase.
# Copier en .env.local pour activer.

# Pointe le SDK Firebase JS sur l'émulateur Firestore local (cf. firebase.json).
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8181

# Le serveur Go tourne en local sur 8080 (cf. server/.env.example).
VITE_WEBSOCKET_URL=ws://localhost:8080

# Project ID utilisé localement (peut être n'importe quoi avec l'émulateur).
VITE_FIREBASE_PROJECT_ID=unlock-local
