# Vue CLI lit ces variables au build/dev avec le préfixe VUE_APP_.
# Copier en .env.local pour le dev, et utiliser .env.production pour le build de prod
# (le script deploy.sh écrit automatiquement .env.production avec l'URL Cloud Run).

VUE_APP_FIREBASE_API_KEY=
VUE_APP_FIREBASE_AUTH_DOMAIN=
VUE_APP_FIREBASE_PROJECT_ID=
VUE_APP_FIREBASE_STORAGE_BUCKET=
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=
VUE_APP_FIREBASE_APP_ID=

# URL WebSocket du serveur (wss://... pour la prod, ws://localhost:8080 pour le dev local).
VUE_APP_WEBSOCKET_URL=
