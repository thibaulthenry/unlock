    "firebase": "^8.6.0",
    "lodash": "^4.17.21",
    "path-parse": ">=1.0.7",
    "phaser": "^3.54.0",
    "url-parse": ">=1.5.2",
    "vue": "^2.6.11",
    "vue-firestore": "^0.3.30",
    "vue-flag-icon": "^1.0.6",
    "vue-i18n": "^8.24.4",
    "vue-router": "^3.5.1",
    "vuetify": "^2.5.0",
    "vuex": "^3.6.2",
    "vuexfire": "^3.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
