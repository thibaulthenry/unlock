# Variables d'environnement du serveur Go.
# En production, elles sont injectées par Cloud Run via deploy.sh.
# En dev local, exporter ces variables avant `go run .`.

# Port HTTP d'écoute (Cloud Run injecte PORT automatiquement).
PORT=8080

# ID du projet GCP hébergeant Firestore.
GCP_PROJECT_ID=unlock-db

# Origines autorisées pour le WebSocket (CSV, sans trailing slash).
ALLOWED_ORIGINS=https://unlock-db.web.app,https://unlock-db.firebaseapp.com

# Optionnel : pour pointer sur l'émulateur Firestore en dev local.
# FIRESTORE_EMULATOR_HOST=localhost:8080
